conda.enabled = true
process.conda = "${projectDir}/environment.yml"

process {
    errorStrategy = 'terminate'

    withLabel: small {
        cpus = 2
        memory = '4 GB'
        time = '2h'
    }

    withLabel: medium {
        cpus = 4
        memory = '8 GB'
        time = '8h'
    }

    withLabel: large {
        cpus = 8
        memory = '16 GB'
        time = '12h'
    }
}

profiles {
    test {
        conda.enabled = false
        process.executor = 'local'
        process.cpus = 1
        process.memory = '1 GB'
        process.time = '30m'
    }

    no_conda {
        conda.enabled = false
    }
}

timeline {
    enabled = true
    file = "${params.outdir ?: 'results'}/pipeline_info/timeline.html"
}

report {
    enabled = true
    file = "${params.outdir ?: 'results'}/pipeline_info/report.html"
}

trace {
    enabled = true
    file = "${params.outdir ?: 'results'}/pipeline_info/trace.txt"
}

dag {
    enabled = true
    file = "${params.outdir ?: 'results'}/pipeline_info/dag.html"
}
